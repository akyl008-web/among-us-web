# Copy to .env (PowerShell: Copy-Item .env.example .env)
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Comma-separated list of allowed browser origins for Socket.IO (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Minimum players to start (default 4). 3 is handy for testing with browser tabs.
MIN_PLAYERS=3

# PostgreSQL (optional). Without it the server stores accounts/stats in memory.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/stellar_suspects

# Secret for signing login tokens (required in production, >= 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Production: serve client/dist from this server
SERVE_CLIENT=false
TRUST_PROXY=false
